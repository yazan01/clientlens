# Any OpenAI-compatible API works. Default: OpenRouter (free models available).
# Get a free key at https://openrouter.ai/keys
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-your-key-here

# Model used by both chatbots. Free OpenRouter models end with ":free".
# Browse: https://openrouter.ai/models?max_price=0
AI_MODEL=baidu/ernie-5.5-flash-preview:free

# Optional: use a different model for the AI Coach (leave empty to use AI_MODEL).
AI_COACH_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Other examples ---
# Local Ollama:   AI_BASE_URL=http://localhost:11434/v1   AI_API_KEY=ollama   AI_MODEL=qwen2.5:7b
# Groq:           AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
